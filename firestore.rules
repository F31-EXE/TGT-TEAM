rules_version = '2';

// Правила доступа к общей базе команды.
// Админ ведёт всё. Боец видит данные команды и может отмечать только СВОЁ участие в играх.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(userDoc()); }
    function isAdmin() { return isMember() && get(userDoc()).data.admin == true; }
    function myMemberId() { return get(userDoc()).data.memberId; }

    // Первый запуск: создаётся одновременно с settings/main, только пока команды ещё нет.
    function bootstrapping() {
      return signedIn()
        && !exists(/databases/$(db)/documents/settings/main)
        && existsAfter(/databases/$(db)/documents/settings/main);
    }

    // Логин → технический email. Читается до входа, но только по точному логину.
    match /logins/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin() || bootstrapping();
    }

    match /users/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow create: if bootstrapping() && uid == request.auth.uid && request.resource.data.admin == true;
    }

    match /settings/{doc} {
      allow read: if isMember();
      allow write: if isAdmin() || bootstrapping();
    }

    match /members/{id} {
      allow read: if isMember();
      allow write: if isAdmin() || bootstrapping();
    }

    match /payments/{month} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /points/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /gear/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Боец может: отметить СВОЁ участие, отметить СВОЙ чек-лист и записаться в машину (подвоз).
    match /events/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance', 'checks', 'rides'])
        && request.resource.data.get('attendance', {}).diff(resource.data.get('attendance', {})).affectedKeys().hasOnly([myMemberId()])
        && request.resource.data.get('checks', {}).diff(resource.data.get('checks', {})).affectedKeys().hasOnly([myMemberId()]);
    }

    // Заявки на баллы и «Я перевёл»: боец создаёт только свои и только на проверку; решает админ.
    function ownPending() {
      return isMember()
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.status == 'pending';
    }
    match /claims/{id} {
      allow read: if isMember();
      allow create: if ownPending();
      allow delete: if isAdmin() || (isMember() && resource.data.memberId == myMemberId() && resource.data.status == 'pending');
      allow update: if isAdmin();
    }
    match /payreports/{id} {
      allow read: if isMember();
      allow create: if ownPending();
      allow delete: if isAdmin() || (isMember() && resource.data.memberId == myMemberId() && resource.data.status == 'pending');
      allow update: if isAdmin();
    }

    // Фото чеков и подтверждений.
    match /files/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.memberId == myMemberId() && request.resource.data.data.size() < 900000;
      allow delete: if isAdmin() || (isMember() && resource.data.memberId == myMemberId());
    }

    match /funds/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Хрон-журнал: свои замеры боец добавляет сам, админ — любые.
    match /chrono/{id} {
      allow read: if isMember();
      allow create: if isAdmin() || (isMember() && request.resource.data.memberId == myMemberId());
      allow update: if isAdmin() || (isMember() && resource.data.memberId == myMemberId() && request.resource.data.memberId == myMemberId());
      allow delete: if isAdmin() || (isMember() && resource.data.memberId == myMemberId());
    }
  }
}
